# Upstox Analytics Token is recommended: read-only and currently valid for one year.
# Never prefix this variable with NEXT_PUBLIC_.
UPSTOX_ACCESS_TOKEN=

# upstox | simulation
MARKET_DATA_PROVIDER=simulation

MARKET_DATA_PORT=8787
MARKET_DATA_STALE_AFTER_MS=15000
DATABASE_PATH=./data/market-pulse.sqlite

